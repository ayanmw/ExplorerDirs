@@ -5723,0 +5715,35 @@ internal sealed class ExplorerBrowserHost : HwndHost, ExplorerBrowserHost.IExplo
+    private async Task CompleteDeletedItemRepairAsync(nint folderView, IReadOnlyList<string> paths,
+        ShellDirectoryMonitorRequest request, ShellDirectoryChangeQueue queue, long version)
+    {
+        var startedAt = _traceNativeUserMessages ? _directoryDeleteNotificationTiming.Start() : 0;
+        try
+        {
+            var result = await ShellDeletedItemNotification.NotifyDeletedItemsAsync(folderView, paths,
+                () => IsCurrentDirectoryMonitorRequest(request),
+                _traceNativeUserMessages ? step => TraceShellSelectionRestore("delete-identity", step) : null,
+                _folderSizeProfileClassId);
+#if EXPLORERDIRS_DELETE_REPAIR_TRACE
+            File.AppendAllText(Path.Combine(AppContext.BaseDirectory, "delete-repair-stages.log"),
+                $"{Environment.TickCount64} owner-end root={Path.GetFileName(Path.GetDirectoryName(paths[0]))};version={version};current={IsCurrentDirectoryMonitorRequest(request)};result={result}\n");
+#endif
+            if (!IsCurrentDirectoryMonitorRequest(request)) return;
+            _directoryChangeLastFolderDeleteNotificationResult = result.ToString();
+            if (result is ShellDeletedItemNotificationResult.Notified or ShellDeletedItemNotificationResult.PartiallyNotified)
+                Interlocked.Increment(ref _directoryChangeNativeFolderDeleteNotifications);
+        }
+        catch (Exception error)
+        {
+            if (IsCurrentDirectoryMonitorRequest(request))
+            {
+                System.Diagnostics.Trace.TraceError($"Explorer Dirs: incremental delete repair failed; hr=0x{error.HResult:X8}");
+                QueueDirectoryChange(version, queue, delta: 0, forceRefresh: true);
+            }
+        }
+        finally
+        {
+            _directoryDeleteNotificationTiming.Stop(startedAt);
+            Marshal.Release(folderView);
+            if (_activeDeleteRepairVersion == version) _activeDeleteRepairVersion = -1;
+        }
+    }
+
