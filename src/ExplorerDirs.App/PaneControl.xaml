<UserControl x:Class="ExplorerDirs.App.PaneControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ExplorerDirs.App">
    <Border BorderBrush="#999" BorderThickness="1" Margin="3">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" LastChildFill="True" Margin="4">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button x:Name="BackButton" Content="←" ToolTip="后退 (Alt+左箭头)" Click="Back_Click" Width="28"/>
                    <Button x:Name="ForwardButton" Content="→" ToolTip="前进 (Alt+右箭头)" Click="Forward_Click" Width="28" Margin="2,0,0,0"/>
                    <Button x:Name="UpButton" Content="↑" ToolTip="上级目录 (Backspace / Alt+上箭头)" Click="Up_Click" Width="28" Margin="2,0,0,0"/>
                    <Button x:Name="RefreshButton" Content="↻" ToolTip="刷新目录" Click="Refresh_Click" Width="28" Margin="4,0,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="GoButton" Content="转到" Click="Go_Click" Margin="4,0,0,0" Padding="8,2"/>
                    <Button x:Name="NewTabButton" Content="+" ToolTip="新建标签页" Click="NewTab_Click" Margin="8,0,0,0" Width="28"/>
                    <Button x:Name="CloseTabButton" Content="×" ToolTip="关闭标签页" Click="CloseTab_Click" Margin="4,0,0,0" Width="28"/>
                </StackPanel>
                <TextBox x:Name="Address" KeyDown="Address_KeyDown" MinWidth="80" Margin="6,0,0,0"
                         VerticalContentAlignment="Center"/>
            </DockPanel>
            <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Margin="6,3" Foreground="#555"/>
            <TabControl x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged"
                        PreviewKeyDown="Tabs_PreviewKeyDown"
                        PreviewMouseMove="Tabs_PreviewMouseMove"
                        PreviewMouseLeftButtonUp="Tabs_PreviewMouseLeftButtonUp">
                <TabControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <local:TabHeaderPanel/>
                    </ItemsPanelTemplate>
                </TabControl.ItemsPanel>
                <TabControl.Template>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="ScrollTabsLeft" Grid.Column="0" Content="‹"
                                        ToolTip="向左滚动标签" AutomationProperties.Name="向左滚动标签"
                                        Focusable="False" IsTabStop="False" Click="ScrollTabsLeft_Click"/>
                                <ScrollViewer x:Name="TabHeaderScroll" Grid.Column="1"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Disabled"
                                              CanContentScroll="False" Focusable="False"
                                              ScrollChanged="TabHeaderScroll_ScrollChanged"
                                              PreviewMouseWheel="TabHeaderScroll_PreviewMouseWheel">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                                <Button x:Name="ScrollTabsRight" Grid.Column="2" Content="›"
                                        ToolTip="向右滚动标签" AutomationProperties.Name="向右滚动标签"
                                        Focusable="False" IsTabStop="False" Click="ScrollTabsRight_Click"/>
                            </Grid>
                            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                    Background="{TemplateBinding Background}">
                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                            </Border>
                        </DockPanel>
                    </ControlTemplate>
                </TabControl.Template>
            </TabControl>
        </DockPanel>
    </Border>
</UserControl>
