<UserControl x:Class="ExplorerDirs.App.PaneControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border BorderBrush="#999" BorderThickness="1" Margin="3">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4">
                <Button Content="↑" ToolTip="上级目录" Click="Up_Click" Width="28"/>
                <Button Content="↻" ToolTip="刷新目录" Click="Refresh_Click" Width="28" Margin="4,0,0,0"/>
                <TextBox x:Name="Address" KeyDown="Address_KeyDown" MinWidth="120" Margin="6,0,0,0"
                         VerticalContentAlignment="Center" Width="300"/>
                <Button Content="转到" Click="Go_Click" Margin="4,0,0,0" Padding="8,2"/>
                <Button Content="+" ToolTip="新建标签页" Click="NewTab_Click" Margin="8,0,0,0" Width="28"/>
                <Button Content="×" ToolTip="关闭标签页" Click="CloseTab_Click" Margin="4,0,0,0" Width="28"/>
            </StackPanel>
            <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Margin="6,3" Foreground="#555"/>
            <TabControl x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged"/>
        </DockPanel>
    </Border>
</UserControl>
