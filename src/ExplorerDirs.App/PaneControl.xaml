<UserControl x:Class="ExplorerDirs.App.PaneControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ExplorerDirs.App">
    <Border x:Name="RootBorder" BorderBrush="{DynamicResource ExplorerDirs.BorderBrush}" BorderThickness="1" Padding="1" Margin="3"
            PreviewMouseWheel="RootBorder_PreviewMouseWheel">
        <DockPanel>
            <DockPanel x:Name="NavigationRow" DockPanel.Dock="Top" LastChildFill="True" Margin="4">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button x:Name="BackButton" ToolTip="后退 (Alt+左箭头)"
                            AutomationProperties.Name="后退" AutomationProperties.AutomationId="PaneGoBack" Click="Back_Click"
                            PreviewMouseRightButtonUp="NavigationHistoryRightClick" Width="28"/>
                    <Button x:Name="ForwardButton" ToolTip="前进 (Alt+右箭头)"
                            AutomationProperties.Name="前进" Click="Forward_Click"
                            PreviewMouseRightButtonUp="NavigationHistoryRightClick" Width="28" Margin="2,0,0,0"/>
                    <Button x:Name="UpButton" ToolTip="上级目录 (Backspace / Alt+上箭头)"
                            AutomationProperties.Name="上级目录" AutomationProperties.AutomationId="PaneGoParent" Click="Up_Click" Width="28" Margin="2,0,0,0"/>
                    <Button x:Name="RefreshButton" ToolTip="刷新目录" AutomationProperties.Name="刷新目录" Click="Refresh_Click" Width="28" Margin="4,0,0,0"/>
                    <ToggleButton x:Name="TreeButton" ToolTip="切换当前窗格目录树" Click="Tree_Click" Width="32" Margin="4,0,0,0"
                                  AutomationProperties.Name="当前窗格目录树"/>
                    <Button x:Name="ToolbarViewStyleButton" ToolTip="切换当前标签的文件视图方式"
                            AutomationProperties.Name="查看方式" Click="ViewStyle_Click" Width="46" Margin="4,0,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="GoButton" Visibility="Collapsed" IsTabStop="False" Content="编辑" ToolTip="编辑地址或转到" Click="Go_Click"
                            LostKeyboardFocus="GoButton_LostKeyboardFocus" Margin="4,0,0,0" Padding="8,2"/>
                </StackPanel>
                <Grid x:Name="AddressHost" MinWidth="80" Margin="6,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition x:Name="AddressMenuColumn" Width="24"/>
                        <ColumnDefinition x:Name="AddressComputerColumn" Width="24"/>
                        <ColumnDefinition x:Name="AddressHistoryColumn" Width="0"/>
                    </Grid.ColumnDefinitions>
                    <ScrollViewer x:Name="BreadcrumbScroll" Grid.Column="0" HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled" Focusable="False" Background="Transparent"
                                  MouseLeftButtonDown="BreadcrumbScroll_MouseLeftButtonDown"
                                  PreviewMouseWheel="BreadcrumbScroll_PreviewMouseWheel">
                        <StackPanel x:Name="BreadcrumbButtons" Orientation="Horizontal"/>
                    </ScrollViewer>
                    <TextBox x:Name="Address" Grid.Column="0" KeyDown="Address_KeyDown"
                             TextChanged="Address_TextChanged"
                             PreviewMouseLeftButtonDown="Address_PreviewMouseLeftButtonDown"
                             LostKeyboardFocus="Address_LostKeyboardFocus"
                             Visibility="Collapsed" VerticalContentAlignment="Center"/>
                    <Button x:Name="AddressMenuButton" Grid.Column="1" Width="24" Padding="0"
                            ToolTip="最近访问和上级目录；F4 打开目录树" AutomationProperties.Name="路径与最近位置"
                            Click="AddressMenu_Click"/>
                    <Button x:Name="AddressComputerButton" Grid.Column="2" Width="24" Padding="0"
                            ToolTip="常用位置、磁盘和收藏夹 (F8)" AutomationProperties.Name="此电脑"
                            Click="AddressComputer_Click"/>
                    <Button x:Name="AddressHistoryButton" Grid.Column="3" Width="24" Padding="0" Visibility="Collapsed" IsTabStop="False"
                            ToolTip="当前标签的访问历史" AutomationProperties.Name="地址历史"
                            Click="AddressHistory_Click"/>
                </Grid>
            </DockPanel>
            <Popup x:Name="AddressTreePopup" PlacementTarget="{Binding ElementName=AddressHost}"
                   Placement="Bottom" StaysOpen="False" Closed="AddressTreePopup_Closed">
                <Border x:Name="AddressTreeBorder" BorderBrush="{DynamicResource ExplorerDirs.BorderBrush}"
                        BorderThickness="1" Background="{DynamicResource ExplorerDirs.WindowBackgroundBrush}"
                        Width="300" Height="340">
                    <local:ShellTreeHost x:Name="AddressTreeHost"/>
                </Border>
            </Popup>
            <DockPanel x:Name="SearchBar" DockPanel.Dock="Top" Margin="4,2,4,0"
                       Visibility="Collapsed" LastChildFill="True">
                <TextBlock x:Name="SearchScopeLabel" DockPanel.Dock="Left" Text="范围：当前目录"
                           ToolTip="当前标签目录" TextTrimming="CharacterEllipsis" MaxWidth="180"
                           VerticalAlignment="Center" Margin="2,0,6,0"/>
                <Button x:Name="CloseSearchButton" DockPanel.Dock="Right" Content="×"
                        ToolTip="返回目录并关闭搜索" Width="28" Margin="4,0,0,0"
                        AutomationProperties.AutomationId="PaneSearchClose"
                        Click="CloseSearch_Click"/>
                <Button x:Name="SearchSubmitButton" DockPanel.Dock="Right" Content="搜索"
                        ToolTip="搜索当前范围" Width="52" Margin="4,0,0,0"
                        AutomationProperties.AutomationId="PaneSearchSubmit"
                        Click="SearchSubmit_Click"/>
                <TextBox x:Name="SearchBox" ToolTip="输入关键词后按 Enter 搜索；Esc 返回目录"
                         AutomationProperties.Name="搜索当前目录" AutomationProperties.AutomationId="PaneSearchQuery"
                         KeyDown="SearchBox_KeyDown"
                         TextChanged="SearchBox_TextChanged"
                         VerticalContentAlignment="Center"/>
            </DockPanel>
            <DockPanel x:Name="QuickFilterBar" DockPanel.Dock="Top" Margin="4,2,4,0"
                       Visibility="Collapsed" LastChildFill="True">
                <Button x:Name="CloseQuickFilterButton" DockPanel.Dock="Right" Content="×"
                        ToolTip="清除筛选并关闭" Width="28" Margin="4,0,0,0"
                        Click="ClearQuickFilter_Click"/>
                <Button x:Name="ApplyQuickFilterButton" DockPanel.Dock="Right" Content="筛选"
                        ToolTip="应用文件名筛选" Width="48" Margin="4,0,0,0"
                        Click="ApplyQuickFilter_Click"/>
                <Button x:Name="DeleteQuickFilterPresetButton" DockPanel.Dock="Right" Content="－"
                        ToolTip="删除选中的筛选预设" Width="28" Margin="4,0,0,0"
                        IsEnabled="False" Click="DeleteQuickFilterPreset_Click"/>
                <Button x:Name="SaveQuickFilterPresetButton" DockPanel.Dock="Right" Content="收藏"
                        ToolTip="将当前筛选设置保存为命名预设" Width="44" Margin="4,0,0,0"
                        Click="SaveQuickFilterPreset_Click"/>
                <ComboBox x:Name="QuickFilterPresetCombo" DockPanel.Dock="Right" Width="116"
                          IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True"
                          DisplayMemberPath="Name" VerticalContentAlignment="Center" Margin="4,0,0,0"
                          SelectionChanged="QuickFilterPresetCombo_SelectionChanged"
                          ToolTip="选择预设载入编辑框；修改名称后可收藏当前设置"/>
                <CheckBox x:Name="FilterFoldersCheckBox" DockPanel.Dock="Right"
                          Content="包括文件夹" VerticalAlignment="Center" Margin="4,0,6,0"/>
                <ComboBox x:Name="QuickFilterMode" DockPanel.Dock="Right" Width="100"
                          SelectedIndex="0" VerticalContentAlignment="Center" Margin="4,0,0,0">
                    <ComboBoxItem Content="包含匹配项"/>
                    <ComboBoxItem Content="排除匹配项"/>
                </ComboBox>
                <ComboBox x:Name="QuickFilterBox" ToolTip="通配符筛选；多个模式用分号分隔，例如 *.txt;*.md；按向下键查看历史"
                          AutomationProperties.Name="快速筛选文件名" IsEditable="True"
                          IsTextSearchEnabled="False" StaysOpenOnEdit="True"
                          DropDownOpened="QuickFilterHistory_DropDownOpened"
                          PreviewKeyDown="QuickFilterBox_PreviewKeyDown"
                          VerticalContentAlignment="Center"/>
            </DockPanel>
            <DockPanel x:Name="StatusBarRow" DockPanel.Dock="Bottom" LastChildFill="True">
                <Button x:Name="ViewStyleButton" DockPanel.Dock="Right"
                        Margin="2,1" Padding="5,0"
                        ToolTip="切换当前窗格标签的查看方式"
                        AutomationProperties.Name="当前窗格查看方式"
                        AutomationProperties.AutomationId="PaneViewStyle"
                        Click="ViewStyle_Click"/>
                <TextBlock x:Name="DiskSpace" DockPanel.Dock="Right" Margin="6,3" MaxWidth="145"
                           Visibility="Collapsed" TextTrimming="CharacterEllipsis"
                           AutomationProperties.AutomationId="PaneDiskSpace"/>
                <TextBlock x:Name="ItemCounts" DockPanel.Dock="Left" Margin="6,3"
                           MaxWidth="290" TextTrimming="CharacterEllipsis"
                           ToolTipService.InitialShowDelay="250" ToolTipService.ShowDuration="60000"
                           AutomationProperties.AutomationId="PaneItemCounts"/>
                <TextBlock x:Name="RecursiveSizeStatus" DockPanel.Dock="Left" Margin="6,3"
                           MaxWidth="420" TextTrimming="CharacterEllipsis" Visibility="Collapsed"
                           AutomationProperties.AutomationId="PaneRecursiveSize"/>
                <TextBlock x:Name="ShellStatusHint" DockPanel.Dock="Left" Margin="6,3" MaxWidth="280"
                           Foreground="{DynamicResource ExplorerDirs.MutedTextBrush}"
                           TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="PaneShellStatusHint"/>
                <TextBlock x:Name="Status" Margin="6,3" Foreground="{DynamicResource ExplorerDirs.MutedTextBrush}"
                           TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="PaneStatus"/>
            </DockPanel>
            <DockPanel>
                <DockPanel x:Name="TabStripRow" DockPanel.Dock="Top" LastChildFill="True">
                <TabControl x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged"
                            PreviewKeyDown="Tabs_PreviewKeyDown"
                            PreviewMouseMove="Tabs_PreviewMouseMove"
                            PreviewMouseLeftButtonUp="Tabs_PreviewMouseLeftButtonUp">
                    <TabControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <local:TabHeaderPanel Multiline="{Binding MultilineTabHeaders, RelativeSource={RelativeSource AncestorType={x:Type local:PaneControl}}}"
                                                   LimitMaximumWidth="{Binding LimitTabHeaderWidth, RelativeSource={RelativeSource AncestorType={x:Type local:PaneControl}}}"/>
                        </ItemsPanelTemplate>
                    </TabControl.ItemsPanel>
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="{x:Type TabItem}">
                            <Setter Property="Background" Value="{DynamicResource ExplorerDirs.ControlBackgroundBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource ExplorerDirs.ControlTextBrush}"/>
                            <Setter Property="Template"><Setter.Value>
                                <ControlTemplate TargetType="{x:Type TabItem}">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}" Padding="4,2">
                                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value></Setter>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0,3,0,0"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource ExplorerDirs.AccentBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TabControl.ItemContainerStyle>
                    <TabControl.Template>
                        <ControlTemplate TargetType="{x:Type TabControl}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="ScrollTabsLeft" Grid.Column="1" Width="28" FontSize="18" Visibility="Collapsed" Content="‹"
                                        ToolTip="向左滚动标签" AutomationProperties.Name="向左滚动标签"
                                        Focusable="False" IsTabStop="False" Click="ScrollTabsLeft_Click"/>
                                <ScrollViewer x:Name="TabHeaderScroll" Grid.Column="0"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Disabled"
                                              CanContentScroll="False" Focusable="False" AllowDrop="True"
                                              PreviewMouseLeftButtonDown="TabHeaderScroll_PreviewMouseLeftButtonDown"
                                              PreviewMouseRightButtonUp="TabHeaderScroll_PreviewMouseRightButtonUp"
                                              Background="Transparent"
                                              DragOver="TabStrip_DragOver" Drop="TabStrip_Drop"
                                              ScrollChanged="TabHeaderScroll_ScrollChanged"
                                              PreviewMouseWheel="TabHeaderScroll_PreviewMouseWheel">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                                <Button x:Name="ScrollTabsRight" Grid.Column="2" Width="28" FontSize="18" Visibility="Collapsed" Content="›"
                                        ToolTip="向右滚动标签" AutomationProperties.Name="向右滚动标签"
                                        Focusable="False" IsTabStop="False" Click="ScrollTabsRight_Click"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding MultilineTabHeaders, RelativeSource={RelativeSource AncestorType={x:Type local:PaneControl}}}" Value="True">
                                    <Setter TargetName="ScrollTabsLeft" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="ScrollTabsRight" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="TabHeaderScroll" Property="HorizontalScrollBarVisibility" Value="Disabled"/>
                                    <Setter TargetName="TabHeaderScroll" Property="VerticalScrollBarVisibility" Value="Auto"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </TabControl.Template>
                </TabControl>
                </DockPanel>
                <Border BorderBrush="{DynamicResource ExplorerDirs.BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="TreeColumn" Width="0"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="TreeContainer" Grid.Column="0" Visibility="Collapsed"
                                BorderBrush="{DynamicResource ExplorerDirs.BorderBrush}" BorderThickness="0,0,1,0"/>
                    <GridSplitter x:Name="TreeSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Center"
                                  ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                                  ShowsPreview="True" Background="{DynamicResource ExplorerDirs.ControlBackgroundBrush}" Cursor="SizeWE"
                                  Focusable="False" IsTabStop="False" Visibility="Collapsed"
                                  AutomationProperties.Name="调整目录树宽度"
                                  DragCompleted="TreeSplitter_DragCompleted"/>
                    <local:PersistentTabHost x:Name="BrowserLayer" Grid.Column="2"/>
                    </Grid>
                </Border>
            </DockPanel>
        </DockPanel>
    </Border>
</UserControl>
