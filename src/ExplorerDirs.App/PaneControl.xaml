<UserControl x:Class="ExplorerDirs.App.PaneControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ExplorerDirs.App">
    <UserControl.Resources>
        <local:FileIconConverter x:Key="FileIconConverter"/>
        <DataTemplate x:Key="FileNameCellTemplate">
            <StackPanel Orientation="Horizontal">
                <Image Source="{Binding Converter={StaticResource FileIconConverter}}"
                       Width="16" Height="16" Margin="0,0,5,0"/>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Border BorderBrush="#999" BorderThickness="1" Margin="3">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" LastChildFill="True" Margin="4">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Content="↑" ToolTip="上级目录" Click="Up_Click" Width="28"/>
                    <Button Content="↻" ToolTip="刷新目录" Click="Refresh_Click" Width="28" Margin="4,0,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="转到" Click="Go_Click" Margin="4,0,0,0" Padding="8,2"/>
                    <Button Content="+" ToolTip="新建标签页" Click="NewTab_Click" Margin="8,0,0,0" Width="28"/>
                    <Button Content="×" ToolTip="关闭标签页" Click="CloseTab_Click" Margin="4,0,0,0" Width="28"/>
                </StackPanel>
                <TextBox x:Name="Address" KeyDown="Address_KeyDown" MinWidth="80" Margin="6,0,0,0"
                         VerticalContentAlignment="Center"/>
            </DockPanel>
            <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Margin="6,3" Foreground="#555"/>
            <TabControl x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged"/>
        </DockPanel>
    </Border>
</UserControl>
