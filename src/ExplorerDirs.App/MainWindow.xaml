<Window x:Class="ExplorerDirs.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Explorer Dirs" Height="800" Width="1280" MinHeight="420" MinWidth="650">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8">
            <TextBlock Text="布局" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="LayoutSelector" Width="110" SelectionChanged="LayoutSelector_SelectionChanged">
                <ComboBoxItem Content="单窗格" Tag="1"/>
                <ComboBoxItem Content="双窗格" Tag="2"/>
                <ComboBoxItem Content="四窗格" Tag="4"/>
            </ComboBox>
            <Button Content="刷新环境变量" Click="RefreshEnvironment_Click" Margin="12,0,0,0" Padding="10,4"/>
            <Button Content="在当前目录打开命令行" Click="OpenTerminal_Click" Margin="8,0,0,0" Padding="10,4"/>
            <TextBlock x:Name="EnvironmentStatus" Margin="12,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <Grid x:Name="PaneGrid" Margin="8,0,8,8"/>
    </DockPanel>
</Window>
