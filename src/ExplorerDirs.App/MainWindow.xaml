<Window x:Class="ExplorerDirs.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ExplorerDirs.App"
        Title="Explorer Dirs" Height="800" Width="1280" MinHeight="420" MinWidth="650"
        Background="{DynamicResource ExplorerDirs.WindowBackgroundBrush}"
        Foreground="{DynamicResource ExplorerDirs.WindowTextBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel>
        <Menu x:Name="MainMenu" DockPanel.Dock="Top">
            <MenuItem x:Name="FileMenu" Header="文件(_F)" SubmenuOpened="FileCommandsMenu_SubmenuOpened">
                <MenuItem x:Name="ImportQdrMenu" Header="导入 Q-Dir 配置 (.qdr)…" Click="ImportQdr_Click"/>
                <MenuItem x:Name="ExportQdrMenu" Header="导出 Q-Dir 状态 (.qdr)…" Click="ExportQdr_Click"/>
                <MenuItem x:Name="ExportFileViewMenu" Header="导出当前文件视图…" Click="ExportFileView_Click"/>
                <MenuItem x:Name="PrintFileViewMenu" Header="打印当前文件视图…" Click="PrintFileView_Click"/>
                <MenuItem x:Name="PrintSelectedPhotosMenu" Header="打印所选照片…" IsEnabled="False" Click="PrintSelectedPhotos_Click"/>
                <Separator/>
                <MenuItem x:Name="NewFolderMenu" Header="新建文件夹" InputGestureText="Ctrl+Shift+N" IsEnabled="False" Click="NewFolder_Click"/>
                <Separator/>
                <MenuItem Header="新建标签页" InputGestureText="Ctrl+T" Click="NewTab_Click"/>
                <MenuItem Header="新建窗口" InputGestureText="Ctrl+N" Click="NewWindow_Click"/>
                <MenuItem Header="关闭标签页" InputGestureText="Ctrl+W" Click="CloseTab_Click"/>
                <Separator/>
                <MenuItem Header="退出" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem x:Name="FileCommandsMenu" Header="编辑(_E)" SubmenuOpened="FileCommandsMenu_SubmenuOpened">
                <MenuItem x:Name="PasteSpecialMenu" Header="粘贴特殊…" InputGestureText="Ctrl+Shift+V"
                          SubmenuOpened="PasteSpecialMenu_SubmenuOpened"/>
            </MenuItem>
            <MenuItem Header="标签页(_T)">
                <MenuItem Header="复制当前标签" InputGestureText="Ctrl+K" Click="DuplicateTab_Click"/>
                <MenuItem Header="关闭其他标签" Click="CloseOtherTabs_Click"/>
                <MenuItem Header="恢复关闭的标签" InputGestureText="Ctrl+Shift+T"
                          ToolTip="文件视图聚焦且单选文件夹时，Ctrl+Shift+T 在新标签打开该文件夹；其他情况下恢复关闭的标签。"
                          Click="ReopenTab_Click"/>
            </MenuItem>
            <MenuItem x:Name="QuickLinksMenu" Header="快速链接(_Q)" InputGestureText="Ctrl+Q" SubmenuOpened="QuickLinksMenu_SubmenuOpened"/>
            <MenuItem x:Name="FavoritesMenu" Header="收藏夹(_B)" SubmenuOpened="FavoritesMenu_SubmenuOpened"/>
            <MenuItem Header="视图(_V)" SubmenuOpened="ViewMenu_SubmenuOpened">
                <MenuItem x:Name="CurrentViewMenu" Header="当前标签查看方式"/>
                <MenuItem x:Name="HiddenItemsMenu" Header="隐藏项目" SubmenuOpened="HiddenItemsMenu_SubmenuOpened">
                    <MenuItem x:Name="HiddenItemsFollowWindowsMenu" Header="跟随 Windows" IsCheckable="True"
                              Tag="FollowWindows" Click="HiddenItemsPreference_Click"/>
                    <MenuItem x:Name="HiddenItemsShowMenu" Header="显示隐藏项目" IsCheckable="True"
                              Tag="Show" Click="HiddenItemsPreference_Click"/>
                    <MenuItem x:Name="HiddenItemsHideMenu" Header="不显示隐藏项目" IsCheckable="True"
                              Tag="Hide" Click="HiddenItemsPreference_Click"/>
                </MenuItem>
                <MenuItem Header="命名查看预设">
                    <MenuItem Header="保存当前查看为预设…" Click="SaveViewPreset_Click"/>
                    <Separator/>
                    <MenuItem x:Name="SavedViewPresetsMenu" Header="已保存的预设" SubmenuOpened="ViewPresetsMenu_SubmenuOpened"/>
                </MenuItem>
                <MenuItem x:Name="LayoutMenu" Header="布局"/>
                <MenuItem x:Name="CompactModeMenu" Header="紧凑布局" IsCheckable="True" Click="CompactMode_Click"/>
                <MenuItem x:Name="TreeModeMenu" Header="目录树">
                    <MenuItem x:Name="TreeModeSharedMenu" Header="共享一棵树" IsCheckable="True" Tag="Shared" Click="TreeMode_Click"/>
                    <MenuItem x:Name="TreeModePerPaneMenu" Header="每窗格各一棵树" IsCheckable="True" Tag="PerPane" Click="TreeMode_Click"/>
                    <MenuItem x:Name="TreeModeNoneMenu" Header="关闭目录树" IsCheckable="True" Tag="None" Click="TreeMode_Click"/>
                </MenuItem>
                <MenuItem x:Name="PreviewPaneMenu" Header="预览窗格" InputGestureText="Alt+P" IsCheckable="True" Click="PreviewPaneMenu_Click"/>
                <MenuItem x:Name="DetailsPaneMenu" Header="详情窗格" InputGestureText="Alt+Shift+P" IsCheckable="True" Click="DetailsPaneMenu_Click"/>
                <Separator/>
                <MenuItem Header="刷新当前目录" InputGestureText="F5" Click="RefreshCurrent_Click"/>
                <MenuItem Header="搜索当前目录" InputGestureText="F3 / Ctrl+E / Ctrl+F" Click="SearchCurrent_Click"/>
            </MenuItem>
            <MenuItem Header="工具(_O)">
                <MenuItem Header="程序启动器…" InputGestureText="Ctrl+S" Click="ProgramStarter_Click"/>
                <Separator/>
                <MenuItem Header="选项">
                    <MenuItem Header="主题">
                        <MenuItem x:Name="SystemThemeMenu" Header="跟随系统" IsCheckable="True" Tag="System" Click="ThemePreference_Click"/>
                        <MenuItem x:Name="LightThemeMenu" Header="浅色" IsCheckable="True" Tag="Light" Click="ThemePreference_Click"/>
                        <MenuItem x:Name="DarkThemeMenu" Header="深色" IsCheckable="True" Tag="Dark" Click="ThemePreference_Click"/>
                    </MenuItem>
                    <MenuItem x:Name="DefaultViewMenu" Header="新建标签默认查看"/>
                    <MenuItem Header="地址栏样式">
                        <MenuItem x:Name="ClassicAddressBarMenu" Header="经典（完整路径）"
                                  IsCheckable="True"
                                  Click="AddressBarStyle_Click"/>
                        <MenuItem x:Name="ModernAddressBarMenu" Header="现代（面包屑）"
                                  IsCheckable="True"
                                  Click="AddressBarStyle_Click"/>
                    </MenuItem>
                    <MenuItem Header="大小显示格式">
                        <MenuItem Header="单位">
                            <MenuItem x:Name="SizeUnitAutoMenu" Header="自动" IsCheckable="True" Tag="Auto" Click="SizeDisplayUnit_Click"/>
                            <MenuItem x:Name="SizeUnitBytesMenu" Header="字节" IsCheckable="True" Tag="Bytes" Click="SizeDisplayUnit_Click"/>
                            <MenuItem x:Name="SizeUnitKbMenu" Header="KB" IsCheckable="True" Tag="Kilobytes" Click="SizeDisplayUnit_Click"/>
                            <MenuItem x:Name="SizeUnitMbMenu" Header="MB" IsCheckable="True" Tag="Megabytes" Click="SizeDisplayUnit_Click"/>
                            <MenuItem x:Name="SizeUnitGbMenu" Header="GB" IsCheckable="True" Tag="Gigabytes" Click="SizeDisplayUnit_Click"/>
                            <MenuItem x:Name="SizeUnitTbMenu" Header="TB" IsCheckable="True" Tag="Terabytes" Click="SizeDisplayUnit_Click"/>
                        </MenuItem>
                        <MenuItem Header="小数位数">
                            <MenuItem x:Name="SizeDecimals0Menu" Header="0 位" IsCheckable="True" Tag="0" Click="SizeDisplayDecimals_Click"/>
                            <MenuItem x:Name="SizeDecimals1Menu" Header="1 位" IsCheckable="True" Tag="1" Click="SizeDisplayDecimals_Click"/>
                            <MenuItem x:Name="SizeDecimals2Menu" Header="2 位" IsCheckable="True" Tag="2" Click="SizeDisplayDecimals_Click"/>
                            <MenuItem x:Name="SizeDecimals3Menu" Header="3 位" IsCheckable="True" Tag="3" Click="SizeDisplayDecimals_Click"/>
                        </MenuItem>
                        <MenuItem x:Name="SizeThousandsSeparatorMenu" Header="千位分隔符" IsCheckable="True" Click="SizeDisplayThousandsSeparator_Click"/>
                        <MenuItem x:Name="SizeRecursiveCountsMenu" Header="F9 显示文件和子目录数量" IsCheckable="True" Click="SizeDisplayRecursiveCounts_Click"/>
                    </MenuItem>
                </MenuItem>
                <Separator/>
                <MenuItem Header="打开崩溃诊断目录" Click="OpenCrashLogDirectory_Click"/>
                <MenuItem Header="网络驱动器">
                    <MenuItem Header="映射网络驱动器…" Click="ConnectNetworkDrive_Click"/>
                    <MenuItem Header="断开网络驱动器…" Click="DisconnectNetworkDrive_Click"/>
                </MenuItem>
                <MenuItem Header="计算当前目录递归大小" InputGestureText="F9" Click="CalculateDirectorySize_Click"/>
                <MenuItem Header="刷新环境变量" Click="RefreshEnvironment_Click"/>
                <MenuItem Header="在当前目录打开命令行" Click="OpenTerminal_Click"/>
            </MenuItem>
        </Menu>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar x:Name="MainToolBar">
                <TextBlock Text="布局" VerticalAlignment="Center" Margin="4,0"/>
                <StackPanel x:Name="LayoutButtons" Orientation="Horizontal"/>
                <Separator/>
                <StackPanel x:Name="FileCommandButtons" Orientation="Horizontal"
                            MouseEnter="FileCommandButtons_Refresh" GotKeyboardFocus="FileCommandButtons_Refresh"/>
                <Separator/>
                <Button x:Name="NewTabToolbarButton" ToolTip="新建标签页 (Ctrl+T)"
                        AutomationProperties.Name="新建标签页" Click="NewTab_Click" Width="32"/>
                <Button x:Name="NewWindowToolbarButton" ToolTip="新建窗口 (Ctrl+N)"
                        AutomationProperties.Name="新建窗口" Click="NewWindow_Click" Width="38"/>
                <Button x:Name="DuplicateTabToolbarButton" ToolTip="复制当前标签 (Ctrl+K)"
                        AutomationProperties.Name="复制当前标签" Click="DuplicateTab_Click" Width="42"/>
                <Button x:Name="CloseTabToolbarButton" ToolTip="关闭标签页 (Ctrl+W)"
                        AutomationProperties.Name="关闭标签页" Click="CloseTab_Click" Width="32"/>
                <ToggleButton x:Name="PreviewPaneToggle" Content="预览" ToolTip="切换当前标签的预览窗格 (Alt+P)"
                              AutomationProperties.Name="切换预览窗格" Click="PreviewPaneToggle_Click"/>
                <ToggleButton x:Name="DetailsPaneToggle" Content="详情" ToolTip="切换当前标签的详情窗格 (Alt+Shift+P)"
                              AutomationProperties.Name="切换详情窗格" Click="DetailsPaneToggle_Click"/>
                <Button x:Name="RefreshCurrentDirectoryButton" ToolTip="刷新当前目录 (F5)" AutomationProperties.Name="刷新当前目录"
                        AutomationProperties.AutomationId="RefreshCurrentDirectory"
                        Click="RefreshCurrent_Click" Width="32"/>
                <Button x:Name="SearchCurrentDirectoryButton" ToolTip="搜索当前目录 (F3)" AutomationProperties.Name="搜索当前目录"
                        AutomationProperties.AutomationId="OpenCurrentDirectorySearch"
                        Click="SearchCurrent_Click" Width="32"/>
                <Button Content="🖨" ToolTip="打印当前文件视图" AutomationProperties.Name="打印当前文件视图"
                        Click="PrintFileView_Click" Width="36"/>
                <Button Content="大小" ToolTip="计算或取消当前目录递归大小 (F9)"
                        AutomationProperties.Name="计算当前目录递归大小" Click="CalculateDirectorySize_Click"/>
                <Separator/>
                <Button Content="↻ 环境" ToolTip="刷新本程序环境变量" Click="RefreshEnvironment_Click"/>
                <Button Content="⌘ 命令行" ToolTip="在当前目录打开命令行" Click="OpenTerminal_Click"/>
            </ToolBar>
        </ToolBarTray>
        <TextBlock x:Name="EnvironmentStatus" DockPanel.Dock="Bottom" Margin="8,2"
                   Foreground="{DynamicResource ExplorerDirs.MutedTextBrush}"/>
        <Grid x:Name="TreeLayoutGrid" Margin="5,2,5,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SharedTreeColumn" Width="0"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="SharedTreeContainer" Grid.Column="0" Visibility="Collapsed"
                    BorderBrush="{DynamicResource ExplorerDirs.BorderBrush}"
                    BorderThickness="1" Margin="0,0,4,0"/>
            <GridSplitter x:Name="SharedTreeSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Center"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                          ShowsPreview="True" Background="{DynamicResource ExplorerDirs.ControlBackgroundBrush}" Cursor="SizeWE"
                          Focusable="False" IsTabStop="False" Visibility="Collapsed"
                          AutomationProperties.Name="调整共享目录树宽度"
                          DragCompleted="SharedTreeSplitter_DragCompleted"/>
            <local:PaneLayoutGrid x:Name="PaneGrid" Grid.Column="2" Margin="0"/>
        </Grid>
    </DockPanel>
</Window>
