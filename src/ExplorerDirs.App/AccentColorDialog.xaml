<Window x:Class="ExplorerDirs.App.AccentColorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="自定义强调色" Width="360" Height="190" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ExplorerDirs.WindowBackgroundBrush}"
        Foreground="{DynamicResource ExplorerDirs.WindowTextBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="输入 RGB 十六进制颜色（例如 #2A7BC4）"/>
        <DockPanel Grid.Row="1" Margin="0,10,0,0">
            <Border x:Name="ColorPreview" Width="32" Height="26" BorderBrush="{DynamicResource ExplorerDirs.BorderBrush}"
                    BorderThickness="1" Margin="0,0,8,0"/>
            <TextBox x:Name="ColorText" VerticalContentAlignment="Center" MaxLength="7"
                     TextChanged="ColorText_TextChanged"/>
        </DockPanel>
        <TextBlock x:Name="ValidationText" Grid.Row="2" Margin="0,6,0,0"
                   Foreground="{DynamicResource ExplorerDirs.MutedTextBrush}"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="确定" IsDefault="True" MinWidth="72" Margin="0,0,8,0"
                    Click="Accept_Click"/>
            <Button Content="取消" IsCancel="True" MinWidth="72"/>
        </StackPanel>
    </Grid>
</Window>
