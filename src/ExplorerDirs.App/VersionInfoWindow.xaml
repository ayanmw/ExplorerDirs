<Window x:Class="ExplorerDirs.App.VersionInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="版本信息" Width="580" Height="490" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ExplorerDirs.WindowBackgroundBrush}"
        Foreground="{DynamicResource ExplorerDirs.WindowTextBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Explorer Dirs" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock x:Name="VersionText" Margin="0,4,0,0"
                       Foreground="{DynamicResource ExplorerDirs.MutedTextBrush}"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Git 提交"/><TextBlock x:Name="GitCommitText" Grid.Column="1" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="1" Text="提交时间（UTC）"/><TextBlock x:Name="CommitTimeText" Grid.Row="1" Grid.Column="1"/>
                <TextBlock Grid.Row="2" Text="源码状态"/><TextBlock x:Name="SourceStateText" Grid.Row="2" Grid.Column="1"/>
                <TextBlock Grid.Row="3" Text="构建配置"/><TextBlock x:Name="ConfigurationText" Grid.Row="3" Grid.Column="1"/>
                <TextBlock Grid.Row="4" Text="目标框架"/><TextBlock x:Name="FrameworkText" Grid.Row="4" Grid.Column="1" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="5" Text="运行时标识"/><TextBlock x:Name="RuntimeText" Grid.Row="5" Grid.Column="1"/>
                <TextBlock Grid.Row="6" Text="Self-contained"/><TextBlock x:Name="SelfContainedText" Grid.Row="6" Grid.Column="1"/>
                <TextBlock Grid.Row="7" Text="编译常量"/><TextBlock x:Name="ConstantsText" Grid.Row="7" Grid.Column="1" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="8" Text="Native AOT"/><TextBlock x:Name="AotText" Grid.Row="8" Grid.Column="1"/>
                <TextBlock Grid.Row="9" Text="单文件发布"/><TextBlock x:Name="SingleFileText" Grid.Row="9" Grid.Column="1"/>
                <TextBlock Grid.Row="10" Text="裁剪发布"/><TextBlock x:Name="TrimmedText" Grid.Row="10" Grid.Column="1"/>
                <TextBlock Grid.Row="11" Text="ReadyToRun"/><TextBlock x:Name="ReadyToRunText" Grid.Row="11" Grid.Column="1"/>
                <TextBlock Grid.Row="12" Text="构建标签"/><TextBlock x:Name="BuildTagsText" Grid.Row="12" Grid.Column="1" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="13" Text="信息版本"/><TextBlock x:Name="InformationalVersionText" Grid.Row="13" Grid.Column="1" TextWrapping="Wrap"/>
            </Grid>
        </ScrollViewer>
        <Button Grid.Row="2" Content="关闭" IsCancel="True" MinWidth="84" Margin="0,14,0,0"
                HorizontalAlignment="Right"/>
    </Grid>
</Window>
